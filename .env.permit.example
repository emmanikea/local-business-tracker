# Vercel cron protection
CRON_SECRET=replace-with-random-secret

# Google Apps Script web app deployed from scripts/permit-sheet-apps-script.gs
PERMIT_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/REPLACE_ME/exec
PERMIT_SHEETS_WEBHOOK_TOKEN=replace-with-shared-secret

# Twilio SMS
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-me
TWILIO_FROM_NUMBER=+15551234567
